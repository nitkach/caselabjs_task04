    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Register user",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
                        },
                        "url": "{{baseUrl}}/api/auth/register"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                                    "pm.test('User is created with viewer role', function () { pm.expect(pm.response.json().data.user.role).to.eql('viewer'); });"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
                        },
                        "url": "{{baseUrl}}/api/auth/login"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                                    "pm.environment.set('accessToken', pm.response.json().data.accessToken);",
                                    "const setCookie = pm.response.headers.get('set-cookie'); if (setCookie) { const m = setCookie.match(/refresh_token=([^;]+)/); if (m) pm.environment.set('refreshToken', decodeURIComponent(m[1])); }"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Refresh token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{baseUrl}}/api/auth/refresh",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.request.headers.add({ key: 'Cookie', value: 'refresh_token=' + pm.environment.get('refreshToken') });"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                                    "pm.environment.set('accessToken', pm.response.json().data.accessToken);"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get current user",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": "{{baseUrl}}/api/auth/me"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                                    "pm.test('User payload is returned', function () { pm.expect(pm.response.json().data.user.email).to.eql(pm.environment.get('email')); });"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{baseUrl}}/api/auth/logout"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
                                ]
                            }
                        }
                    ]
                }
            ]
