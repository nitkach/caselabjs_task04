{
  "name": "task_02",
  "version": "1.0.0",
  "description": "Simple TypeScript API skeleton with middleware, validation, logging and error handling",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "db:grant:grafana": "node db/grant-grafana-reader.cjs",
    "db:migrate": "sequelize-cli db:migrate --config db/sequelize-cli.cjs --migrations-path db/migrations --seeders-path db/seeders",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config db/sequelize-cli.cjs --migrations-path db/migrations --seeders-path db/seeders",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all --config db/sequelize-cli.cjs --migrations-path db/migrations --seeders-path db/seeders",
    "db:seed:all": "sequelize-cli db:seed:all --config db/sequelize-cli.cjs --migrations-path db/migrations --seeders-path db/seeders",
    "db:seed:undo:all": "sequelize-cli db:seed:undo:all --config db/sequelize-cli.cjs --migrations-path db/migrations --seeders-path db/seeders"
  },
  "keywords": [
    "typescript",
    "express",
    "middleware",
    "validation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sequelize-typescript": "^2.1.6",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "jest": "^30.5.2",
    "sqlite3": "^6.0.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
