WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_FORECAST_DAYS=3
WEATHER_MAX_PRECIPITATION=1
WEATHER_MAX_WIND_SPEED_KMH=30

NODE_ENV=production
PORT=3000
HTTP_PORT=80
REQUEST_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
JSON_BODY_LIMIT=2mb
URL_ENCODED_BODY_LIMIT=10kb
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

ACCESS_TOKEN_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_TECHNICIAN_EMAIL=
AUTH_BOOTSTRAP_TECHNICIAN_PASSWORD=
AUTH_BOOTSTRAP_TECHNICIAN_ID=

POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_locally
GRAFANA_DB_PASSWORD=change_me_grafana_locally
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin
GRAFANA_DOMAIN=localhost

PGHOST=localhost
PGPORT=5432
PGDATABASE=appdb
PGUSER=app
PGPASSWORD=change_me_locally
PG_POOL_MAX=10
PG_POOL_MIN=0
PG_POOL_ACQUIRE_MS=30000
PG_POOL_IDLE_MS=10000
